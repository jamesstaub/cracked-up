{
  "name": "cracked-up",
  "version": "0.1.0",
  "description": "A TypeScript reimagining of \"I Dropped My Phone The Screen Cracked\" by Bill Orcutt: build and sequence Web Audio graphs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesstaub/cracked-up.git"
  },
  "homepage": "https://jamesstaub.github.io/cracked-up/",
  "bugs": "https://github.com/jamesstaub/cracked-up/issues",
  "type": "module",
  "sideEffects": [
    "./dist/global/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nodes": {
      "types": "./dist/nodes/index.d.ts",
      "import": "./dist/nodes/index.js"
    },
    "./worklets": {
      "types": "./dist/worklets/index.d.ts",
      "import": "./dist/worklets/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js"
    },
    "./midi": {
      "types": "./dist/midi/index.d.ts",
      "import": "./dist/midi/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./global": {
      "types": "./dist/global/index.d.ts",
      "import": "./dist/global/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "sources": "node scripts/extract-sources.mjs",
    "build": "npm run sources && tsup",
    "demo": "vite demo --open",
    "demo:build": "vite build demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project chromium",
    "test:all-browsers": "vitest run --project chromium --project firefox --project webkit",
    "lint": "node scripts/extract-sources.mjs --check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:all-browsers",
    "preversion": "npm run check",
    "version": "node scripts/changelog.mjs release && git add CHANGELOG.md",
    "release:notes": "node scripts/changelog.mjs notes"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.39.5",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.39.5",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
